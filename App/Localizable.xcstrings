    "settings.privacy.statement" : {
      "comment" : "The local-only privacy statement shown in the Privacy settings tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything Focus Sentinel knows about you stays on this Mac. There is no account, no sync, no telemetry and no analytics, and the app ships with no network entitlement at all. Your priorities, sessions and rules live in one local file:"
          }
        }
      }
