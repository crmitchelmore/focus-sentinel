    "settings.privacy.grant.accessibility.help" : {
      "comment" : "Tooltip on the Accessibility grant opt-in switch. Revised for the opt-in privacy posture (2026-10-20): read on device, and shared only with the remote judge when that is switched on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows the app to ask macOS for Accessibility access, then read what is selected in the app in front. It stays on this Mac unless you switch on Ask Decision-1."
          }
        }
      }
    },
    "settings.privacy.remoteJudge" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): switch for the opt-in remote judge, Microsoft Decision-1. Off by default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Decision-1 whether a window is part of your work"
          }
        }
      }
    },
    "settings.privacy.remoteJudge.note" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): revised for the owner's opt-in privacy posture (2026-10-20): local first, nothing leaves the Mac unless the person switches it on, and the remote judge may see everything the app knows. Note under the remote-judge switch: off keeps everything local; on may send everything the app knows. Says what may be sent, where, and what it needs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, nothing Focus knows leaves this Mac. On, Focus judges your work far better: when its own rules cannot tell, it may send Microsoft's Decision-1 on Azure everything it knows that helps — your priorities and their context, what the app in front shows (its title, selected item, address, file and visible text), your busy times and your tasks. It can only keep Focus quiet, never make it speak. Nothing is sent from password managers or private windows, nothing sent is kept, and it needs Accessibility above and a signed-in Azure CLI."
          }
        }
      }
    },
    "settings.privacy.remoteJudge.help" : {
      "comment" : "Tooltip on the remote-judge switch. Revised for the opt-in privacy posture (2026-10-20).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Microsoft's Decision-1 see what Focus knows — your priorities, the window in front, your busy times and your tasks — when the rules cannot tell whether a window is part of your work."
