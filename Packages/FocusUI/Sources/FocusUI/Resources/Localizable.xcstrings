    "capture.finding.noLeadingVerb" : {
      "comment" : "Refinement explanation: the sentence does not begin with an imperative verb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That describes a state rather than naming a job."
          }
        }
      }
    },
    "capture.finding.noOutcome" : {
      "comment" : "Refinement explanation: there is a verb but no concrete outcome.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That names an action but not what it will produce."
          }
        }
      }
    },
    "capture.finding.nounOnlyPhrase" : {
      "comment" : "Refinement explanation: the sentence is a bare noun phrase.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That names a topic rather than something to do."
          }
        }
      }
    },
    "capture.finding.tooShort" : {
      "comment" : "Refinement explanation: the sentence is a single word or barely any characters.",
