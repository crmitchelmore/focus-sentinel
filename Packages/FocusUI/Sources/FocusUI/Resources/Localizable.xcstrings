    "shell.walkthrough.settings.privacy" : {
      "comment" : "Walkthrough page 7: the Privacy pane (capability table, retention, the opt-in grants and the remote judge). The last sentence is the opt-in posture of 2026-10-20: nothing asked and nothing sent unless switched on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy settings list every signal Focus reads, how long it keeps activity, the permissions you can give and Ask Decision-1. Focus asks for nothing and sends nothing unless you switch it on."
          }
        }
      }
    },
    "shell.walkthrough.settings.replay" : {
