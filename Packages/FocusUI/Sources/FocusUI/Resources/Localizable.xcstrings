    "settings.privacy.grant.accessibility" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): new copy, not yet reviewed by the user. Switch that lets the app ask macOS for Accessibility (focus-exdi.4).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Focus ask for Accessibility"
          }
        }
      }
    },
    "settings.privacy.grant.accessibility.note" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): revised for the owner's opt-in privacy posture (2026-10-20): local first, nothing leaves the Mac unless the person switches it on, and the remote judge may see everything the app knows. Note under the Accessibility switch (issue #24): on device unless the remote judge is on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Accessibility, Focus reads what is selected in the app in front — the window's title, or the chat, mailbox or folder you picked — to tell which task you are on. It reads only when it is about to ask you something, never in password managers or private windows, and keeps only a short name for it. What it reads stays on this Mac unless you also switch on Ask Decision-1 below. Switching this on asks macOS; macOS asks you."
          }
        }
      }
    },
    "settings.privacy.grant.screenCapture" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): new copy, not yet reviewed by the user. Switch that lets the app ask macOS for Screen Recording.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Focus ask for Screen Recording"
          }
        }
      }
    },
    "settings.privacy.grant.screenCapture.note" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): new copy, not yet reviewed by the user. Note under the Screen Recording switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Recording would let Focus read the pixels of what is in front of you. Switching this on asks macOS; macOS asks you."
          }
        }
      }
    },
    "settings.privacy.grant.calendar" : {
      "comment" : "APPROVED BY USER (D-11, 2026-10-15; review delegated by the user to Gemini 4 Argon). Switch that lets the app ask macOS for access to the person's calendars (focus-cal).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Focus read when you are in meetings"
          }
        }
      }
    },
    "settings.privacy.grant.calendar.note" : {
      "comment" : "APPROVED BY USER (D-11, 2026-10-15; review delegated by the user to Gemini 4 Argon). Note under the calendar switch (focus-cal).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus reads only when your events start and end — never their titles, places or people — and keeps none of it. A focus block will not be set to run into a meeting, and Focus stays quiet while one is on. Switching this on asks macOS; macOS asks you."
          }
        }
      }
    },
    "settings.privacy.grant.unused" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): new copy, not yet reviewed by the user. Warning beside a switch whose grant nothing in this build reads.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in this version reads what this would unlock."
          }
        }
      }
    },
    "settings.privacy.grants.explanation" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): revised for the owner's opt-in privacy posture (2026-10-20): local first, nothing leaves the Mac unless the person switches it on, and the remote judge may see everything the app knows. Explanation under the grants heading.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus asks macOS for nothing unless you switch it on here. Everything above works without any of these; each one you give lets Focus see more and judge better, and switching one off stops Focus using it."
          }
        }
      }
    },
    "settings.privacy.grants.heading" : {
