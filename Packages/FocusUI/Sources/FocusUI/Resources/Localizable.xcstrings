    "shell.firstRun.permissions" : {
      "comment" : "PENDING HUMAN APPROVAL (D-11): revised for the owner's opt-in privacy posture (2026-10-20): local first, nothing leaves the Mac unless the person switches it on, and the remote judge may see everything the app knows. First-run sheet: the opt-in posture — nothing asked and nothing sent unless switched on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus asks macOS for nothing unless you switch it on in Privacy settings, and nothing leaves this Mac unless you switch on Ask Decision-1 there. Each one you switch on gives Focus more to go on."
          }
        }
      }
    },
    "shell.firstRun.never" : {
      "comment" : "First-run sheet: what the app never reads. The list is exhaustive on purpose.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your Accessibility opt-in, Focus identifies the selected session, document or browser page on this Mac. Raw titles, URL credentials, queries and fragments are not stored. It does not take screenshots or record what you type."
          }
        }
      }
    },
    "shell.firstRun.observes" : {
      "comment" : "First-run sheet: what the app reads.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus reads which app is active. If you enable Accessibility in Privacy, it can also identify the selected view or browser page and ask about that content instead of the whole app."
          }
        }
      }
    },
    "shell.firstRun.title" : {
      "comment" : "First-run sheet: the heading. Shown once, on a store the app has never opened.",
